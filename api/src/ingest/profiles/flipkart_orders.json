{
  "id": "flipkart_orders",
  "label": "Flipkart Seller Hub orders report",
  "marketplace": "flipkart",
  "match_headers": ["Ordered On", "Shipment ID", "ORDER ITEM ID", "Order Id", "Order State", "FSN", "SKU", "Product", "Invoice Amount", "Selling Price Per Item", "Shipping Charge per item", "Quantity"],
  "map": {
    "order_id": ["Order Id", "Order ID", "ORDER ITEM ID"],
    "date": ["Ordered On", "Order Date", "Order Approval Date"],
    "gross_inr": ["Selling Price Per Item", "Price inc. FKMP Contribution & Subsidy", "Invoice Amount"],
    "returned": ["Order State", "Order Status"],
    "product_id": ["SKU", "FSN"],
    "units": ["Quantity", "Item Quantity"],
    "payment_type": ["Payment Type", "Payment Mode", "Payment Method"],
    "discount_inr": null,
    "product_cost_inr": null,
    "shipping_inr": null,
    "payment_fee_inr": null,
    "refund_inr": null,
    "return_cost_inr": null,
    "recovered_product_cost_inr": null
  },
  "constants": { "channel": "flipkart" },
  "transforms": {
    "date": { "op": "date" },
    "gross_inr": { "op": "multiply", "column": "Quantity" },
    "returned": { "op": "match", "pattern": "return|rto" }
  },
  "notes": [
    "gross = Selling Price Per Item × Quantity.",
    "Order State RETURNED, RETURN_REQUESTED or RTO counts as returned.",
    "Seller discount, refund, commission and shipping fees are in the Flipkart settlement (payments) report, not this orders report: they stay unknown (null) here, never zero.",
    "Shipping Charge per item is what the buyer paid, so it is not used as shipping cost."
  ]
}
