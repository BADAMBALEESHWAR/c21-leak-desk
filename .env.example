# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 1 = template text only (the demo runs fully without AI)
AI_DISABLED=1
# Leave empty for the in-memory store (decisions are not persisted)
MONGO_URL=mongodb://localhost:27017/leakdesk
# Empty = files under data/
S3_BUCKET=
PORT=8080
# Only needed when the web app is served from a different origin than the API
CORS_ORIGIN=
