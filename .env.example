# Copy to .env and fill in. Never commit .env or any real key.
# Every variable is optional for a local run: with none set, the API uses an in-memory store, template text instead of AI,
# local file storage, and no sign-in. On AWS these come from SSM Parameter Store (/leakdesk/*), never from the repo.

# --- Core ---
PORT=8080
# Empty = in-memory store (data is lost on restart)
MONGO_URL=mongodb://localhost:27017/leakdesk
# Empty = files under data/
S3_BUCKET=
AWS_REGION=ap-south-1
# Only needed when the web app is served from a different origin than the API
CORS_ORIGIN=
# Public address of the site; used for sign-in and Shopify redirect URLs
PUBLIC_URL=http://localhost:5173

# --- AI (Google Gemini). 1 = template text only; the product works fully without AI ---
AI_DISABLED=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Sign-in (each provider is off until both of its values are set) ---
# At least 32 random characters; signs the login cookie
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Email sign-in through Amazon Cognito (all three or none)
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# --- Integrations (optional) ---
# Razorpay payment links for "Fix this" (use test keys, rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Shopify app install flow; the paste-a-token connect works without these
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
